#!/usr/bin/env python3
import base64
import json
import os
import sqlite3
import ssl
import sys
import urllib.request
from collections import defaultdict
from datetime import datetime, timedelta

CONFIG = "/etc/ntop-tools.conf"

def load_config():
    cfg = {}
    if os.path.exists(CONFIG):
        with open(CONFIG, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip()
    for k, v in os.environ.items():
        if k.startswith("NTOP_"):
            cfg[k] = v
    return cfg

CFG = load_config()
HOST = CFG.get("NTOP_HOST", "127.0.0.1")
PORT = CFG.get("NTOP_PORT", "3001")
USER = CFG.get("NTOP_USER", "admin")
PASSWORD = CFG.get("NTOP_PASS", "")
IFID = CFG.get("NTOP_IFID", "1")
PER_PAGE = int(CFG.get("NTOP_PER_PAGE", "5000"))
DB = CFG.get("NTOP_DB", "/var/lib/ntop-tools/traffic.db")
BASE = f"https://{HOST}:{PORT}"
CTX = ssl._create_unverified_context()

