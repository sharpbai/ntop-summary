#!/usr/bin/env python3
"""Watch a dynamic TUN device and restart the pmacct capture service on recreation.

No network changes. Uses Linux sysfs (5-second polling), not an external Python module.
"""
import argparse
import os
import subprocess
import time
from pathlib import Path

def snapshot(name):
    base = Path("/sys/class/net") / name
    try:
        index = int((base / "ifindex").read_text())
        state = (base / "operstate").read_text().strip()
        rx = int((base / "statistics/rx_bytes").read_text())
        tx = int((base / "statistics/tx_bytes").read_text())
        return index, state, rx + tx
    except (OSError, ValueError):
        return None

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--interface", required=True)
    p.add_argument("--service", default="pmacct-summary.service")
    p.add_argument("--output-dir", default="/var/lib/ntop-tools/pmacct")
    p.add_argument("--interval", type=int, default=5)
    p.add_argument("--stale-seconds", type=int, default=180)
    p.add_argument("--cooldown", type=int, default=60)
    args = p.parse_args()
    previous = snapshot(args.interface)
    last_restart = 0
    previous_bytes = previous[2] if previous else None
    last_progress = time.monotonic()
    while True:
        time.sleep(max(2, args.interval))
        current = snapshot(args.interface)
        now = time.monotonic()
        if current is None:
            previous = None
            previous_bytes = None
            last_progress = now
            continue
        if previous is None or current[0] != previous[0]:
            # Wait for the newly created interface to settle.
            time.sleep(3)
            again = snapshot(args.interface)
            if again is None or again[0] != current[0]:
                continue
            current = again
            if now - last_restart >= args.cooldown:
                print(f"ifindex changed: {previous} -> {current}; restarting {args.service}", flush=True)
                subprocess.run(["systemctl", "restart", args.service], check=False, timeout=30)
                last_restart = time.monotonic()
                last_progress = last_restart
        elif previous_bytes is not None and current[2] > previous_bytes:
            newest = max((x.stat().st_mtime for x in Path(args.output_dir).glob("pmacct-*.json")), default=0)
            if newest and time.time() - newest > args.stale_seconds and now - last_progress > args.stale_seconds:
                if now - last_restart >= args.cooldown:
                    print("Interface traffic rising but JSON output stale; restarting capture", flush=True)
                    subprocess.run(["systemctl", "restart", args.service], check=False, timeout=30)
                    last_restart = time.monotonic()
                    last_progress = last_restart
            elif newest and time.time() - newest <= args.stale_seconds:
                last_progress = now
        previous, previous_bytes = current, current[2]

if __name__ == "__main__":
    main()
